# -----------------------------------------------------------------------------
# MEDE-CLI - Variáveis de Ambiente de Exemplo
# -----------------------------------------------------------------------------

# Chave de acesso da API OpenAI (ou de provedor compatível)
OPENAI_API_KEY=sua-chave-api-aqui

# Nível de verbosidade do logger (opções: error | warn | info | debug)
# Padrão é "warn" em produção
MEDE_LOG_LEVEL=warn

# Ativa detalhes adicionais de stacktrace em erros (true | false)
MEDE_DEBUG=false

# Quantidade de retentativas automáticas em chamadas de LLM (padrão: 2)
MEDE_LLM_RETRIES=2

# Define se a base de dados SQLite deve rodar apenas em memória (true | false)
MEDE_IN_MEMORY=false

# Caminho alternativo para a persistência de credenciais (Tokens do login)
# MEDE_VAULT_PATH=

# Tipo de armazenador de credenciais do cofre (file | keychain)
MEDE_CREDENTIALS_HELPER=file

# -----------------------------------------------------------------------------
# Variáveis de Qualidade e Cobertura de Testes (E2E / CI)
# -----------------------------------------------------------------------------

# Limite mínimo de qualidade estrutural esperado nos markdowns (percentual de 0 a 100)
# Padrão é 70 se omitido
MEDE_TEST_MIN_QUALITY=70

# Thresholds mínimos de cobertura de código do Vitest (statements, branches, functions, lines)
MEDE_COVERAGE_STATEMENTS=52
MEDE_COVERAGE_BRANCHES=34
MEDE_COVERAGE_FUNCTIONS=57
MEDE_COVERAGE_LINES=52
