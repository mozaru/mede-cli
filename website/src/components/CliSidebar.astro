---
import { getLangFromUrl, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;

const menuItems = lang === 'pt-BR' ? [
  { path: '/cli/instalacao', label: '1. Instalação & Requisitos', icon: '📥' },
  { path: '/cli/configuracao', label: '2. Configuração (JSON)', icon: '⚙️' },
  { path: '/cli/comandos', label: '3. Referência de Comandos', icon: '💻' },
  { path: '/cli/llm', label: '4. Integração com LLMs', icon: '🧠' }
] : [
  { path: '/cli/instalacao', label: '1. Installation & Requirements', icon: '📥' },
  { path: '/cli/configuracao', label: '2. Configuration (JSON)', icon: '⚙️' },
  { path: '/cli/comandos', label: '3. Command Reference', icon: '💻' },
  { path: '/cli/llm', label: '4. LLM Integration', icon: '🧠' }
];

const activeItem = menuItems.find(item => {
  const localized = localizePath(item.path, lang);
  return pathname === localized || pathname === `${localized}/`;
});

const activePath = activeItem?.path || '';
---

<aside class="docs-sidebar">
  <div class="sidebar-section">
    <h3 class="sidebar-title">{lang === 'pt-BR' ? 'Documentação da CLI' : 'CLI Documentation'}</h3>
    <ul class="sidebar-menu">
      {menuItems.map(item => (
        <li class="sidebar-item">
          <a 
            href={localizePath(item.path, lang)} 
            class:list={['sidebar-link', { active: activePath === item.path }]}
          >
            <span style="margin-right: 0.5rem;">{item.icon}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
  
  <div style="margin-top: 3rem; padding: 1rem; background-color: rgba(6, 17, 41, 0.02); border-radius: 8px; border: 1px solid hsl(var(--color-border));">
    <p style="font-size: 0.8rem; color: hsl(var(--color-text-muted)); margin-bottom: 0.5rem; font-weight: 600; text-transform: uppercase;">
      {lang === 'pt-BR' ? 'Conceito Primeiro' : 'Theory First'}
    </p>
    <p style="font-size: 0.85rem; margin-bottom: 0.75rem;">
      {lang === 'pt-BR' ? 'Entenda a metodologia teórica MEDE antes de operar a CLI.' : 'Understand the theoretical MEDE methodology before operating the CLI.'}
    </p>
    <a href={localizePath('/metodologia', lang)} style="font-size: 0.85rem; font-weight: 700; color: hsl(var(--color-primary)); display: inline-flex; align-items: center; gap: 0.25rem;">
      {lang === 'pt-BR' ? 'Ler os Artigos' : 'Read the Papers'} &rarr;
    </a>
  </div>
</aside>
