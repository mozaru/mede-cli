---
import { getCollection } from 'astro:content';

const entries = await getCollection('metodologia');
const enEntries = entries
  .filter(entry => entry.id.startsWith('en/'))
  .sort((a, b) => {
    const orderDiff = (a.data.order || 0) - (b.data.order || 0);
    if (orderDiff !== 0) return orderDiff;
    return a.id.localeCompare(b.id);
  });

const firstSlug = enEntries.length > 0 
  ? enEntries[0].id.replace(/^en\//, '')
  : 'introducao';

return Astro.redirect(`/en/metodologia/${firstSlug}`);
---
