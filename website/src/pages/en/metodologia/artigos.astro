---
import Layout from '../../../layouts/Layout.astro';
import MethodologySidebar from '../../../components/MethodologySidebar.astro';

const articles = [
  {
    num: "01",
    title: "Article - Milestone",
    doi: "10.5281/zenodo.18188250",
    recordUrl: "https://zenodo.org/records/18188250",
    downloadPt: "https://zenodo.org/records/18188250/files/artigo%20-%20pedra%20fundamental_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/18188250/files/artigo%20-%20pedra%20fundamental_en-us.pdf?download=1",
    description: "Establishes the theoretical foundations of Software Engineering 4.0 and the need for documentary governance."
  },
  {
    num: "02",
    title: "Article 2 - SE4.0 Essential Complexity",
    doi: "10.5281/zenodo.19004664",
    recordUrl: "https://zenodo.org/records/19004664",
    downloadPt: "https://zenodo.org/records/19004664/files/artigo2-es4.0-complexidade-essencial_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19004664/files/artigo2-es4.0-complexidade-essencial_en-us.pdf?download=1",
    description: "Discusses the essential and accidental complexity in enterprise systems and the boundaries of knowledge representation."
  },
  {
    num: "03",
    title: "Article 3 - MEDE (Structured Document Evolution Methodology)",
    doi: "10.5281/zenodo.20006453",
    recordUrl: "https://zenodo.org/records/20006453",
    downloadPt: "https://zenodo.org/records/20006453/files/artigo03-mede_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/20006453/files/artigo03-mede_en-us.pdf?download=1",
    description: "The core paper describing the inner workings of the MEDE methodology in causal-dependency-based evolution cycles."
  },
  {
    num: "04",
    title: "Article 4 - SE4.0: From Code Production to Knowledge Governance",
    doi: "10.5281/zenodo.19101646",
    recordUrl: "https://zenodo.org/records/19101646",
    downloadPt: "https://zenodo.org/records/19101646/files/artigo4-es4.0-da-producao-de-codigo-a-governanca-do-conhecimento-da-solucao_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19101646/files/artigo4-es4.0-da-producao-de-codigo-a-governanca-do-conhecimento-da-solucao_en-us.pdf?download=1",
    description: "Corporate governance theory over the technical truth of complex information systems."
  },
  {
    num: "05",
    title: "Article 5 - MEDE Instrumenter for Tracking and Observability",
    doi: "10.5281/zenodo.19110315",
    recordUrl: "https://zenodo.org/records/19110315",
    downloadPt: "https://zenodo.org/records/19110315/files/artigo5-mede-instrumentador-para-rastreamento-observabilidade_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19110315/files/artigo5-mede-instrumentador-para-rastreamento-observabilidade_en-us.pdf?download=1",
    description: "Technical focus on the instrumentation and observability of change logs and document update tracking."
  },
  {
    num: "06",
    title: "Article 6 - Janus Rationale",
    doi: "10.5281/zenodo.19205969",
    recordUrl: "https://zenodo.org/records/19205969",
    downloadPt: "https://zenodo.org/records/19205969/files/artigo06-janus-fundamentacao_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19205969/files/artigo06-janus-fundamentacao_en-us.pdf?download=1",
    description: "Theoretical and software engineering foundations behind the Janus infrastructure."
  },
  {
    num: "07",
    title: "Article 7 - Janus Technical Architecture",
    doi: "10.5281/zenodo.19209719",
    recordUrl: "https://zenodo.org/records/19209719",
    downloadPt: "https://zenodo.org/records/19209719/files/artigo07-janus-arquitetura-tecnica_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19209719/files/artigo07-janus-arquitetura-tecnica_en-us.pdf?download=1",
    description: "Low-level description and block diagrams of the physical architecture and execution details of Janus."
  },
  {
    num: "08",
    title: "Article 8 - Janus and Software Engineering 4.0",
    doi: "10.5281/zenodo.19209974",
    recordUrl: "https://zenodo.org/records/19209974",
    downloadPt: "https://zenodo.org/records/19209974/files/artigo08-janus-e-engenharia-de-software-4.0_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19209974/files/artigo08-janus-e-engenharia-de-software-4.0_en-us.pdf?download=1",
    description: "The symbiosis between the Janus code execution platform and business knowledge governance."
  },
  {
    num: "09",
    title: "Article 9 - Janus and MEDE",
    doi: "10.5281/zenodo.19210104",
    recordUrl: "https://zenodo.org/records/19210104",
    downloadPt: "https://zenodo.org/records/19210104/files/artigo09-janus-e-mede_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19210104/files/artigo09-janus-e-mede_en-us.pdf?download=1",
    description: "Analysis of the integration between MEDE document cycles and Janus real-time compilation and instrumentation."
  },
  {
    num: "10",
    title: "Article 10 - Industrial Adoption and Developer Workflow Changes",
    doi: "10.5281/zenodo.19210226",
    recordUrl: "https://zenodo.org/records/19210226",
    downloadPt: "https://zenodo.org/records/19210226/files/artigo10-adocao-industrial-e-mudanca-do-trabalho-de-desenvolvimento_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19210226/files/artigo10-adocao-industrial-e-mudanca-do-trabalho-de-desenvolvimento_en-us.pdf?download=1",
    description: "Real case studies regarding the industrial transition and operational impact of adopting MEDE."
  },
  {
    num: "11",
    title: "Article 11 - The Complete Ecosystem",
    doi: "10.5281/zenodo.19221329",
    recordUrl: "https://zenodo.org/records/19221329",
    downloadPt: "https://zenodo.org/records/19221329/files/artigo11-ecossistema%20completo_pt-br.pdf?download=1",
    downloadEn: "https://zenodo.org/records/19221329/files/artigo11-ecossistema%20completo_en-us.pdf?download=1",
    description: "Integrated bird's eye view of the complete Janus ecosystem, MEDE, and the unified knowledge governance architecture."
  }
];
---

<Layout title="Scientific Library - MEDE Methodology">
  <div class="docs-layout">
    <MethodologySidebar />
    <article class="docs-content prose">
      <h1>Scientific and Academic Library</h1>
      
      <p>
        The MEDE methodology is backed by a solid theoretical and academic research base. Below is the complete catalog of research papers published and hosted in the <strong>Zenodo</strong> open repository.
      </p>

      <div style="display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem;">
        {articles.map((art) => (
          <div style="background-color: hsl(var(--color-card)); border: 1px solid hsl(var(--color-border)); border-radius: var(--radius-md); padding: 1.75rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; border-bottom: 1px dashed hsl(var(--color-border)); padding-bottom: 0.5rem;">
              <span style="font-weight: 800; font-size: 1.1rem; color: hsl(var(--color-accent));">Paper {art.num}</span>
              <span style="font-size: 0.8rem; font-family: var(--font-mono); opacity: 0.6;">DOI: {art.doi}</span>
            </div>
            
            <h3 style="margin-top: 0; margin-bottom: 0.5rem; font-size: 1.25rem;">
              <a href={art.recordUrl} target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">
                {art.title}
              </a>
            </h3>
            
            <p style="font-size: 0.95rem; color: hsl(var(--color-text-muted)); margin-bottom: 1.25rem;">
              {art.description}
            </p>
            
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
              <a href={art.downloadPt} class="btn btn-outline" style="padding: 0.4rem 1rem; border-radius: 8px; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                📥 Portuguese (PDF)
              </a>
              <a href={art.downloadEn} class="btn btn-outline" style="padding: 0.4rem 1rem; border-radius: 8px; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                📥 English (PDF)
              </a>
              <a href={art.recordUrl} target="_blank" rel="noopener noreferrer" style="padding: 0.4rem 1rem; border-radius: 8px; font-size: 0.85rem; color: hsl(var(--color-text-muted)); font-weight: 600;">
                🔗 Zenodo Record &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </article>
  </div>
</Layout>
